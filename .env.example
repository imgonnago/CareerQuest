# =========================================================
# PostgreSQL
# =========================================================
POSTGRES_DB=careerquest
POSTGRES_USER=careerquest
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=
POSTGRES_PORT=


# =========================================================
# NAVER API HUB - Web Search
# 실제 값은 .env에만 입력
# =========================================================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 개발 중 CareerQuest 자체 호출 제한
NAVER_SEARCH_DAILY_BUDGET=5000


# =========================================================
# Kakao REST API - Web Search
# =========================================================
KAKAO_REST_API_KEY=

KAKAO_SEARCH_DAILY_BUDGET=5000


# =========================================================
# 공공데이터포털
# 공공데이터포털에서 제공하는 "일반 인증키(Decoding)" 권장
# =========================================================
DATA_GO_KR_API_KEY=

# 국가자격 관심자격 정보
DATA_GO_QNET_ATTENTION_URL=http://openapi.q-net.or.kr/api/service/rest/InquiryAttenQualSVC/getList

# 국가자격 종목별 자격정보
# 활용신청 상세 화면의 '요청주소'를 그대로 붙여넣기
DATA_GO_QNET_ITEM_URL=

# 대학별 학과정보_GW
# 활용신청 상세 화면의 '요청주소'를 그대로 붙여넣기
DATA_GO_UNIV_DEPT_URL=

# API별 CareerQuest 자체 일일 한도
QNET_ATTENTION_DAILY_BUDGET=5000
QNET_ITEM_DAILY_BUDGET=500
UNIV_DEPT_DAILY_BUDGET=5000

# 한 번 실행할 때 최대 페이지 수
COLLECTOR_MAX_PAGES=5

# 페이지당 요청 데이터 수
COLLECTOR_ROWS_PER_PAGE=100

# 연속 요청 방지
API_MIN_INTERVAL_SECONDS=0.3


# =========================================================
# 현재 미사용 / 추후 사용
# =========================================================
SARAMIN_API_KEY=
WORK24_API_KEY=
GITHUB_TOKEN=


# =========================================================
# Local LLM / Embedding
# =========================================================
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3
LLM_NUM_CTX=32768